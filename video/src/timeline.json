          "cues": [
            {
              "from": 0,
              "to": 108,
              "text": "每天讀一篇商業英文文章"
            },
            {
              "from": 108,
              "to": 246,
              "text": "點到不熟的單字，右邊會顯示它在這句話的意思"
            },
            {
              "from": 246,
              "to": 360,
              "text": "按「存到生字本」，單字和原句就存起來了"
            }
          ]
        },
        {
          "id": "vocab",
          "frames": 390,
          "cues": [
            {
              "from": 0,
              "to": 128,
              "text": "到「我的生字本」，按「開始練習」"
            },
            {
              "from": 128,
              "to": 270,
              "text": "用原本的句子挖空，選出正確的意思"
            },
            {
              "from": 270,
              "to": 390,
              "text": "答錯越多的字，越早出現在練習裡"
            }
          ]
        },
        {
          "id": "charades",
          "frames": 450,
          "cues": [
            {
              "from": 0,
              "to": 134,
              "text": "點「用我的生字玩」，從單字本抽題"
            },
            {
              "from": 142,
              "to": 300,
              "text": "看到單字後，用英文描述它，不能直接說出這個字"
            },
            {
              "from": 300,
              "to": 450,
              "text": "AI 猜中就拿星星；猜不中最多再試 3 次"
            }
          ]
        },
        {
          "id": "addback",
          "frames": 330,
          "cues": [
            {
              "from": 0,
              "to": 128,
              "text": "一般模式結束後，沒猜中的字會列在結算畫面"
            },
            {
              "from": 128,
              "to": 330,
              "text": "按「全部加入」（或單字旁的「加入單字本」），它們就回到生字本"
            }
          ]
        },
